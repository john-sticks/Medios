# Copy this file as .env on the production server and set real values there.
# Never commit the production .env file.
MEDIOS_IMAGE=medios:latest
MEDIOS_CONTAINER_NAME=medios
MEDIOS_BIND_ADDRESS=127.0.0.1
MEDIOS_PORT=5102
MYSQL_CONNECTION_STRING=Server=mysql-host;Port=3306;User=medios_app;Password=change-me;Database=medios;Connection Timeout=5;CharSet=utf8mb4;
CERBERUS_BASE_URL=https://cerberus.example.internal
CERBERUS_SERVICE_API_KEY=change-me
REVERSE_PROXY_KNOWN_PROXY=
OPENROUTER_API_KEY=
