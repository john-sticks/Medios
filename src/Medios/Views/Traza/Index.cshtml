@using Medios.Services
@using Medios.Entities
@{
    ViewData["Title"] = "Traza";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var modo = ViewBag.Modo as string ?? "nota";
    var q = ViewBag.Q as string;
    var resultados = ViewBag.Resultados as List<NotaBuscadorItem>;
    var resultadosSintesis = ViewBag.ResultadosSintesis as List<Sintesis>;
    var tipos = ViewBag.Tipos as string[] ?? Array.Empty<string>();
    var delegaciones = ViewBag.Delegaciones as List<Delegacion> ?? new();
    var filtroTipo = ViewBag.FiltroTipo as string;
    var filtroDeleg = ViewBag.FiltroDelegacionId as int?;
    string AmbColor(string? a) => a == "Nacional" ? "#c0392b" : a == "Provincial" ? "#1a5276" : "#2471a3";
}

<div class="row">
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-sitemap"></i> Traza</h3>
            </div>
            <div class="box-body">
                <!-- Tabs -->
                <ul class="nav nav-tabs" style="margin-bottom:16px;">
                    <li class="@(modo != "sintesis" ? "active" : "")">
                        <a href="/Traza?modo=nota"><i class="fa fa-newspaper-o"></i> Por Nota</a>
                    </li>
                    <li class="@(modo == "sintesis" ? "active" : "")">
                        <a href="/Traza?modo=sintesis"><i class="fa fa-file-text"></i> Por Síntesis</a>
                    </li>
                </ul>

                @if (modo == "sintesis")
                {
                    <form method="get" asp-action="Index" class="form-inline" style="margin-bottom:14px;">
                        <input type="hidden" name="modo" value="sintesis" />
                        <div class="form-group" style="margin-right:8px;">
                            <label style="margin-right:4px;">Desde</label>
                            <input type="date" name="fechaDesde" class="form-control input-sm" value="@ViewBag.FiltroFechaDesde" />
                        </div>
                        <div class="form-group" style="margin-right:8px;">
                            <label style="margin-right:4px;">Hasta</label>
                            <input type="date" name="fechaHasta" class="form-control input-sm" value="@ViewBag.FiltroFechaHasta" />
                        </div>
                        <div class="form-group" style="margin-right:8px;">
                            <label style="margin-right:4px;">Tipo</label>
                            <select name="tipo" class="form-control input-sm">
                                <option value="">Todos</option>
                                @foreach (var t in tipos)
                                {
                                    <option value="@t" selected="@(t == filtroTipo)">@t</option>
                                }
                            </select>
                        </div>
                        <div class="form-group" style="margin-right:8px;">
                            <label style="margin-right:4px;">Delegación</label>
                            <select name="delegacionId" class="form-control input-sm">
                                <option value="">Todas</option>
                                <option value="0" selected="@(filtroDeleg == 0)">— Consolidadas —</option>
                                @foreach (var d in delegaciones)
                                {
                                    <option value="@d.Id" selected="@(filtroDeleg == d.Id)">@d.Nombre</option>
                                }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm"><i class="fa fa-search"></i> Buscar</button>
                    </form>

                    @if (resultadosSintesis != null)
                    {
                        @if (!resultadosSintesis.Any())
                        {
                            <p class="text-muted">No se encontraron síntesis con esos filtros.</p>
                        }
                        else
                        {
                            <table class="table table-hover table-bordered">
                                <thead>
                                    <tr><th>#</th><th>Fecha</th><th>Tipo</th><th>Delegación</th><th>Notas</th><th>Estado</th><th></th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in resultadosSintesis)
                                    {
                                        <tr>
                                            <td><strong>@s.Id</strong></td>
                                            <td>@s.Fecha.ToString("dd/MM/yyyy")</td>
                                            <td>@s.Tipo</td>
                                            <td>@(s.Delegacion?.Nombre ?? "Consolidada (División)")</td>
                                            <td><span class="badge bg-blue">@s.NotasIncluidas.Count</span></td>
                                            <td><span class="label label-default">@s.Estado</span></td>
                                            <td><a href="/Traza/Sintesis/@s.Id" class="btn btn-xs btn-info"><i class="fa fa-sitemap"></i> Ver traza</a></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }
                }
                else
                {
                    <form method="get" asp-action="Index" class="form-inline" style="margin-bottom:14px;">
                        <input type="hidden" name="modo" value="nota" />
                        <div class="input-group" style="width:60%;">
                            <input type="text" name="q" class="form-control" value="@q"
                                   placeholder="Buscar por título, fuente o número de nota (#ID)" autofocus />
                            <span class="input-group-btn">
                                <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> Buscar</button>
                            </span>
                        </div>
                    </form>

                    @if (resultados != null)
                    {
                        @if (!resultados.Any())
                        {
                            <p class="text-muted">No se encontraron notas para "<strong>@q</strong>".</p>
                        }
                        else
                        {
                            <table class="table table-hover table-bordered">
                                <thead>
                                    <tr><th>#</th><th>Título</th><th>Ámbito / Categoría</th><th>Estado</th><th>Delegación</th><th></th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in resultados)
                                    {
                                        <tr>
                                            <td><strong>@r.NotaId</strong></td>
                                            <td>@r.Titulo</td>
                                            <td>
                                                @if (r.AmbitoNota != null) { <span class="label" style="background:@AmbColor(r.AmbitoNota);font-size:10px;">@r.AmbitoNota</span> }
                                                <small>@r.CategoriaNombre</small>
                                            </td>
                                            <td><span class="label label-default">@r.EstadoRevision</span></td>
                                            <td><small>@(r.DelegacionNombre ?? "—")</small></td>
                                            <td><a href="/Traza/Detalle/@r.NotaId" class="btn btn-xs btn-info"><i class="fa fa-sitemap"></i> Ver traza</a></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }
                }
            </div>
        </div>
    </div>
</div>
