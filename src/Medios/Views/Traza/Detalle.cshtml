@using Medios.Services
@using Medios.Entities
@model NotaTraza

@{
    ViewData["Title"] = $"Traza — Nota #{Model.NotaId}";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var eventos = ViewBag.Eventos as List<TrazaEventoEntity> ?? new();

    // Estilo (color + ícono + etiqueta) por tipo de evento
    (string color, string icono, string etiqueta) Estilo(string evento) => evento switch
    {
        TrazaService.NotaCreada      => ("#00a65a", "fa-plus-circle", "Nota creada"),
        TrazaService.NotaModificada  => ("#3c8dbc", "fa-pencil", "Nota modificada"),
        TrazaService.NotaAmpliada    => ("#f39c12", "fa-expand", "Nota ampliada"),
        TrazaService.NotaAprobada    => ("#00a65a", "fa-check", "Nota aprobada"),
        TrazaService.NotaDescartada  => ("#dd4b39", "fa-times", "Nota descartada"),
        TrazaService.NotaEliminada   => ("#dd4b39", "fa-trash", "Nota eliminada"),
        TrazaService.NotaAgregada    => ("#605ca8", "fa-plus", "Nota agregada (Medios)"),
        TrazaService.SesionRemitida  => ("#00c0ef", "fa-send", "Sesión remitida"),
        TrazaService.SesionRevisada  => ("#00a65a", "fa-check-square-o", "Sesión revisada"),
        TrazaService.SesionFinalizada => ("#001f3f", "fa-flag-checkered", "Sesión finalizada"),
        TrazaService.SintesisGenerada => ("#8B4513", "fa-file-text-o", "Síntesis generada"),
        TrazaService.SintesisPdf     => ("#8B4513", "fa-file-pdf-o", "PDF de síntesis"),
        TrazaService.SintesisRemitida => ("#f39c12", "fa-send", "Síntesis remitida"),
        TrazaService.SintesisConsolidada => ("#605ca8", "fa-object-group", "Síntesis consolidada"),
        TrazaService.SintesisInformada => ("#39cccc", "fa-bullhorn", "Síntesis informada / publicada"),
        TrazaService.ConsolidacionRevertida => ("#dd4b39", "fa-undo", "Consolidación revertida"),
        _ => ("#3c8dbc", "fa-circle", evento)
    };
    // SUPERVISOR/ANALISTA ya no son roles activos (fusionados en MEDIOS), pero eventos
    // históricos previos a la migración guardan ese Rol tal cual se logueó en su momento —
    // se conserva el color para no perder distinción visual en trazas viejas.
    string RolColor(string? rol) => rol switch
    {
        "DELEGACION" => "#00c0ef",
        "MEDIOS" or "SUPERVISOR" or "ANALISTA" => "#00a65a",
        "DESARROLLADOR" => "#001f3f",
        _ => "#777"
    };
}

<div class="row">
    <div class="col-md-10 col-md-offset-1">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-sitemap"></i> Traza de la Nota #@Model.NotaId</h3>
                <div class="box-tools pull-right">
                    <a href="javascript:history.back()" class="btn btn-default btn-sm"><i class="fa fa-arrow-left"></i> Volver</a>
                    <a href="/NotaBuscador/Detalle/@Model.NotaId" class="btn btn-info btn-sm"><i class="fa fa-eye"></i> Ver ficha</a>
                </div>
            </div>
            <div class="box-body">
                <div class="callout callout-info" style="margin-bottom:18px;">
                    <h4 style="margin-top:0;">@Model.Titulo</h4>
                    <p style="margin:0;">
                        Registrada el <strong>@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</strong>
                        @if (!string.IsNullOrEmpty(Model.Delegacion)) { <text>· @Model.Delegacion</text> }
                        @if (Model.NotaOrigenId.HasValue)
                        {
                            <text>· <span class="label label-warning">Copia de nota
                                <a href="/Traza/Detalle/@Model.NotaOrigenId" style="color:#fff; text-decoration:underline;">#@Model.NotaOrigenId</a></span></text>
                        }
                    </p>
                </div>

                @if (!eventos.Any())
                {
                    <p class="text-muted">
                        <i class="fa fa-info-circle"></i>
                        No hay eventos de trazabilidad registrados para esta nota todavía.
                        La traza registra los movimientos a partir de su implementación
                        (las notas anteriores no tienen historial).
                    </p>
                }
                else
                {
                    <ul class="timeline">
                        @{ string? diaActual = null; }
                        @foreach (var e in eventos)
                        {
                            var dia = e.Fecha.ToString("dd/MM/yyyy");
                            if (dia != diaActual)
                            {
                                diaActual = dia;
                                <li class="time-label"><span class="bg-blue">@dia</span></li>
                            }
                            var (color, icono, etiqueta) = Estilo(e.Evento);
                            <li>
                                <i class="fa @icono" style="background:@color; color:#fff;"></i>
                                <div class="timeline-item">
                                    <span class="time"><i class="fa fa-clock-o"></i> @e.Fecha.ToString("HH:mm")</span>
                                    <h3 class="timeline-header" style="font-size:14px;">
                                        <span class="label" style="background:@color; font-size:10px;">@etiqueta</span>
                                        @if (e.Version.HasValue) { <span class="label label-default" style="font-size:10px;">v@(e.Version)</span> }
                                        @if (!string.IsNullOrEmpty(e.Estado)) { <span class="label label-default" style="font-size:10px;">@e.Estado</span> }
                                        @if (!string.IsNullOrEmpty(e.Rol))
                                        {
                                            <span class="label" style="background:@RolColor(e.Rol); font-size:10px;">@e.Rol</span>
                                        }
                                        @if (!string.IsNullOrEmpty(e.Usuario)) { <small class="text-muted">— @e.Usuario</small> }
                                    </h3>
                                    @if (!string.IsNullOrEmpty(e.Detalle))
                                    {
                                        <div class="timeline-body" style="font-size:13px;">@e.Detalle</div>
                                    }
                                </div>
                            </li>
                        }
                        <li><i class="fa fa-flag-checkered bg-gray"></i></li>
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
