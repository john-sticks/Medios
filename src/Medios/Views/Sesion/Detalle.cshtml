@using Medios.Entities
@model SesionPrensa

@{
    ViewData["Title"] = $"{(Model.Estado == "Borrador" ? "Borrador Síntesis" : "Síntesis")} {Model.Turno} — {Model.Fecha:dd/MM/yyyy}";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var esPropietario = (bool)ViewBag.EsPropietario;
    var esBorrador    = Model.Estado == "Borrador";
    var esRemitida    = Model.Estado == "Remitida";
    var esFinalizada  = Model.Estado == "Finalizada";
    var esMedios      = User.IsInRole("MEDIOS");
    var puedeAnalizar = esMedios && (esRemitida || esFinalizada);
    var puedeRevisar  = esMedios;
    var puedeAmpliar = esMedios || User.IsInRole("DELEGACION");
    var categorias = ViewBag.Categorias as List<CategoriaNoticia>;
    var partidos = ViewBag.Partidos as List<Partido>;
    var sintesisPorOrigen = ViewBag.SintesisPorOrigen as Dictionary<int, Medios.Entities.Sintesis> ?? new();
    var snapshotVersiones = ViewBag.SnapshotVersiones as Dictionary<int, Medios.Entities.NotaVersion> ?? new();
    var lineasTiempo = ViewBag.LineasTiempo as Dictionary<int, Medios.Services.NotaLineaTiempo> ?? new();
    var notasLibres = ViewBag.NotasLibres as List<Medios.Entities.NotaPrensa> ?? new();

    // Geo sin duplicar: si la Localidad ya trae el partido entre paréntesis para desambiguar
    // (ej. "SAN GENARO (MONTE)"), o directamente coincide con el nombre del Partido, no repetirlo.
    string FormatGeoCorta(Partido partido, Localidad? localidad)
    {
        var loc = localidad?.Nombre ?? "";
        var sufijo = $"({partido.Nombre})";
        if (loc.EndsWith(sufijo, StringComparison.OrdinalIgnoreCase))
            loc = loc[..^sufijo.Length].Trim();
        if (loc.Length == 0 || string.Equals(loc, partido.Nombre, StringComparison.OrdinalIgnoreCase))
            return partido.Nombre;
        return $"{partido.Nombre} — {loc}";
    }
}

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success alert-dismissible"><button type="button" class="close" data-dismiss="alert">&times;</button>@TempData["Ok"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible"><button type="button" class="close" data-dismiss="alert">&times;</button>@TempData["Error"]</div>
}

<!-- ── FORMULARIO AGREGAR NOTA (solo propietario en borrador, arriba y colapsable) ── -->
@if (esPropietario && esBorrador)
{
    <div class="row">
        <div class="col-md-12">
            <div class="box box-success collapsed-box">
                <div class="box-header with-border" style="cursor:pointer" data-widget="collapse">
                    <h3 class="box-title"><i class="fa fa-plus-circle"></i> Agregar Nota</h3>
                    <div class="box-tools pull-right">
                        <button type="button" class="btn btn-box-tool"><i class="fa fa-plus"></i></button>
                    </div>
                </div>
                <div class="box-body" style="display:none">
                    <form method="post" asp-controller="Sesion" asp-action="AgregarNota" id="formAgregarNota">
                        <input type="hidden" name="sesionId" value="@Model.Id" />
                        <input type="hidden" name="latitud"  id="hLatitud" />
                        <input type="hidden" name="longitud" id="hLongitud" />

                        <div class="row">
                            <!-- Columna izquierda: campos de texto -->
                            <div class="col-md-7">
                                <div class="row">
                                    @{ ViewData["AmbitoPrefix"] = "Ses"; ViewData["Categorias"] = categorias; ViewData["CatIdInicial"] = 0; }
                                    @await Html.PartialAsync("_AmbitoCategoria")
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <label>Partido <span class="text-red">*</span> <small class="text-muted">(si Ámbito = Partido)</small></label>
                                            <select name="partidoId" id="selPartido" class="form-control">
                                                <option value="">— Todos —</option>
                                                @foreach (var p in partidos!)
                                                {
                                                    <option value="@p.IdPartido">@p.Nombre</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <label>Localidad</label>
                                            <select name="localidadId" id="selLocalidad" class="form-control">
                                                <option value="">— Ninguna —</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Fuente <span class="text-red">*</span></label>
                                            <input type="text" name="fuente" class="form-control" maxlength="200" required />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>
                                                Link
                                                <button type="button" id="btnScrapearSes" class="btn btn-xs btn-info" style="margin-left:8px;" title="Importar título y texto desde la URL">
                                                    <i class="fa fa-download"></i> Importar desde URL
                                                </button>
                                                <span id="scrapSpinnerSes" style="display:none; margin-left:6px;"><i class="fa fa-spinner fa-spin"></i></span>
                                            </label>
                                            <input type="url" name="link" id="sesLink" class="form-control" maxlength="2000" />
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label>Título <span class="text-red">*</span></label>
                                    <input type="text" name="titulo" class="form-control" required maxlength="500" />
                                </div>
                                <div class="form-group">
                                    <label>Texto <span class="text-red">*</span></label>
                                    <textarea name="texto" id="sesTexto" class="form-control" rows="5" required></textarea>
                                </div>
                                <div class="form-group">
                                    <label>Fecha y hora de la noticia <small class="text-muted">(cuándo ocurrió)</small></label>
                                    <input type="datetime-local" name="fechaNoticia" class="form-control"
                                           value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                                </div>
                                <div class="form-group">
                                    <label>
                                        Síntesis IA
                                        <button type="button" id="btnGenIA" class="btn btn-xs btn-default" style="margin-left:8px;">
                                            <i class="fa fa-magic"></i> Generar con IA
                                        </button>
                                        <span id="sesIASpinner" style="display:none; margin-left:6px;">
                                            <i class="fa fa-spinner fa-spin"></i>
                                        </span>
                                    </label>
                                    <textarea name="sintesis" id="sesSintesis" class="form-control" rows="3"
                                              placeholder="Síntesis generada por IA (opcional, editable)"></textarea>
                                </div>
                                <div class="form-group">
                                    <label>Otros medios <small class="text-muted">(repercusión periodística, separados por coma)</small></label>
                                    <input type="text" name="otrosMedios" class="form-control" maxlength="300" placeholder="Ej: LANACION,INFOBAE" />
                                </div>
                                <div class="form-group">
                                    <label><input type="checkbox" name="esRepercusion" value="true" /> Es repercusión</label>
                                </div>
                                @{ ViewData["Sufijo"] = ""; ViewData["ImagenUrl"] = null; ViewData["VideoUrl"] = null; }
                                @await Html.PartialAsync("_ImagenVideoNota")
                            </div>

                            <!-- Columna derecha: dirección + mapa -->
                            <div class="col-md-5">
                                <div class="form-group">
                                    <label>Dirección del hecho</label>
                                    <div class="input-group">
                                        <input type="text" id="inputDireccion" name="direccion"
                                               class="form-control" maxlength="500"
                                               placeholder="Ej: Av. Colón 1234, Mar del Plata" />
                                        <span class="input-group-btn">
                                            <button type="button" class="btn btn-default" id="btnBuscarDir" title="Buscar en mapa">
                                                <i class="fa fa-search"></i>
                                            </button>
                                        </span>
                                    </div>
                                    <small class="text-muted">O hacé clic en el mapa para fijar la ubicación.</small>
                                </div>
                                <div id="mapaNota" style="height:280px; border-radius:4px; border:1px solid #ddd;"></div>
                                <div id="previewBajoMapa"></div>
                                <div id="coordsDisplay" class="text-muted" style="font-size:11px; margin-top:4px; display:none;">
                                    <i class="fa fa-map-marker"></i> <span id="coordsText"></span>
                                </div>
                            </div>
                        </div>

                        @{ Html.RenderPartial("~/Views/Shared/_CaratulaModalidadSelects.cshtml"); }

                        <div class="row">
                            <div class="col-md-12">
                                <button type="submit" class="btn btn-success">
                                    <i class="fa fa-plus"></i> Agregar Nota
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

