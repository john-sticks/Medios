@{
    ViewData["Title"] = "Nueva Sesión de Prensa";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var fechaVal = ViewBag.FechaHoy as string ?? "";
}

<div class="row">
    <div class="col-md-6 col-md-offset-3">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h3 class="box-title">Nueva Sesión de Prensa</h3>
            </div>
            <div class="box-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible">
                        <button type="button" class="close" data-dismiss="alert">&times;</button>
                        <i class="fa fa-exclamation-triangle"></i> @TempData["Error"]
                    </div>
                }
                <form method="post" asp-controller="Sesion" asp-action="Nueva">
                    <div class="form-group">
                        <label>Fecha</label>
                        <input type="date" name="fecha" class="form-control"
                               value="@ViewBag.FechaHoy" required />
                    </div>
                    <div class="form-group">
                        <label>Turno</label>
                        <select name="turno" class="form-control" required>
                            @foreach (var t in ViewBag.Turnos as string[])
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-plus"></i> Crear Sesión
                    </button>
                    <a href="/Sesion/Mias" class="btn btn-default">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>
