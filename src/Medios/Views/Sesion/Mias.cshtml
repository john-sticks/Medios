@using Medios.Entities
@model List<SesionPrensa>

@{
    ViewData["Title"] = "Borradores";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var cantSinRemitir = (int)(ViewBag.CantNotasSinRemitir ?? 0);
    var cantRechazadas = (int)(ViewBag.CantNotasRechazadas ?? 0);
}

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        @TempData["Ok"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        @TempData["Error"]
    </div>
}

@if (cantRechazadas > 0)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-times-circle"></i>
        <strong>@cantRechazadas nota@(cantRechazadas > 1 ? "s fueron rechazadas" : " fue rechazada")</strong>
        por Medios. Revisá los motivos, corregí el contenido en caso de corresponder o eliminar la nota.
        <a href="/Sesion/NotasSinRemitir" class="btn btn-xs btn-danger" style="margin-left:10px;">
            <i class="fa fa-list"></i> Ver notas rechazadas
        </a>
    </div>
}

@if (cantSinRemitir > 0)
{
    <div class="alert alert-warning alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-exclamation-triangle"></i>
        <strong>@cantSinRemitir nota@(cantSinRemitir > 1 ? "s tienen" : " tiene") versiones sin informar.</strong>
        Fueron ampliadas pero aún no fueron enviadas en ninguna síntesis.
        <a href="/Sesion/NotasSinRemitir" class="btn btn-xs btn-warning" style="margin-left:10px;">
            <i class="fa fa-list"></i> Ver notas
        </a>
    </div>
}

<div class="row">
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h3 class="box-title">Borradores — EXPLOTACION DE PRENSA</h3>
                <div class="box-tools">
                    <a href="/Sesion/Nueva" class="btn btn-primary btn-sm">
                        <i class="fa fa-plus"></i> Nuevo Borrador
                    </a>
                </div>
            </div>
            <div class="box-body">
                @if (!Model.Any())
                {
                    <p class="text-muted">No tenés borradores activos. <a href="/Sesion/Nueva">Crear el primero</a>.</p>
                }
                else
                {
                    <table class="table table-hover table-bordered">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Tipo</th>
                                <th>Notas</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model)
                            {
                                <tr>
                                    <td>@s.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td>@s.Turno</td>
                                    <td><span class="badge bg-blue">@s.Notas.Count</span></td>
                                    <td style="white-space:nowrap;">
                                        <a href="/Sesion/Detalle/@s.Id" class="btn btn-default btn-xs">
                                            <i class="fa fa-eye"></i> Ver
                                        </a>
                                        <button type="button" class="btn btn-danger btn-xs"
                                                onclick="confirmarEliminar(@s.Id, @s.Notas.Count)">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal de eliminación con dos opciones -->
<div class="modal fade" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"><i class="fa fa-trash"></i> Eliminar borrador</h4>
            </div>
            <div class="modal-body">
                <p id="msgEliminar"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-warning" id="btnSoloBorrador">
                    <i class="fa fa-folder-open-o"></i> Solo el borrador
                    <small style="display:block; font-size:10px;">Las notas quedan en "Notas"</small>
                </button>
                <button type="button" class="btn btn-danger" id="btnBorradorYNotas">
                    <i class="fa fa-trash"></i> Borrador y notas
                    <small style="display:block; font-size:10px;">Elimina todo</small>
                </button>
            </div>
        </div>
    </div>
</div>

<form id="formEliminarBorrador" method="post" action="/Sesion/EliminarBorrador" style="display:none;">
    <input type="hidden" name="id" id="eliminarBorradorId" />
    <input type="hidden" name="eliminarNotas" id="eliminarNotasValue" />
</form>

@section Scripts {
    <script>
        function confirmarEliminar(sesionId, cantNotas) {
            if (cantNotas === 0) {
                if (confirm('¿Eliminar este borrador vacío?')) {
                    document.getElementById('eliminarBorradorId').value = sesionId;
                    document.getElementById('eliminarNotasValue').value = 'true';
                    document.getElementById('formEliminarBorrador').submit();
                }
                return;
            }

            document.getElementById('msgEliminar').textContent =
                'Este borrador contiene ' + cantNotas + ' nota(s). ¿Qué querés hacer con ellas?';
            document.getElementById('eliminarBorradorId').value = sesionId;

            $('#modalEliminar').modal('show');
        }

        document.getElementById('btnSoloBorrador').addEventListener('click', function () {
            document.getElementById('eliminarNotasValue').value = 'false';
            $('#modalEliminar').modal('hide');
            document.getElementById('formEliminarBorrador').submit();
        });

        document.getElementById('btnBorradorYNotas').addEventListener('click', function () {
            document.getElementById('eliminarNotasValue').value = 'true';
            $('#modalEliminar').modal('hide');
            document.getElementById('formEliminarBorrador').submit();
        });
    </script>
}
