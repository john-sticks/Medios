@{Layout=null;}
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Keryx — Cambiar clave de emergencia</title><link rel="stylesheet" href="/adminlte/bower_components/bootstrap/dist/css/bootstrap.css"></head><body style="background:#293e50"><main style="max-width:520px;margin:7vh auto;padding:32px;background:white;border-radius:8px"><h2>Definí tu clave de emergencia</h2><p>Debe tener entre 14 y 128 caracteres. Es independiente de Cerberus.</p>@if(ViewBag.Error is string error){<div class="alert alert-danger">@error</div>}<form action="/Login/CambiarClaveEmergencia" method="post">@Html.AntiForgeryToken()<div class="form-group"><label>Nueva clave</label><input type="password" class="form-control" name="password" minlength="14" maxlength="128" autocomplete="new-password" required></div><div class="form-group"><label>Repetir clave</label><input type="password" class="form-control" name="repetir" minlength="14" maxlength="128" autocomplete="new-password" required></div><button class="btn btn-primary">Guardar e ingresar</button></form></main></body></html>
