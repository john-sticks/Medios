@using Medios.Services.Respaldos
@model RespaldoVista
@{
    var s=Model.Estado;
    var contingencia=Context.Request.Query["seccion"]=="contingencia";
    string Hora(DateTimeOffset? d)=>d?.ToOffset(TimeSpan.FromHours(-3)).ToString("dd/MM/yyyy HH:mm")??"—";
}
@await Html.PartialAsync("_MonitorTabs")
<link rel="stylesheet" href="~/css/respaldos.css" asp-append-version="true">
<div class="backup-monitor">
@if(TempData["Error"] is string error){<div class="alert alert-danger">@error</div>}
@if(TempData["Ok"] is string ok){<div class="alert alert-success">@ok</div>}
@if(TempData["CodigoInstalacion"] is string codigo){<div class="alert alert-warning"><strong>Código de instalación de un solo uso (vence en 10 minutos)</strong><br><code>@codigo</code><p>Ingresalo en el bloque SSH del instalador. No lo pegues en el chat.</p></div>}
@if(Model.Aviso!=null){<div class="alert alert-warning">@Model.Aviso</div>}
@if(TempData["ClaveEmergencia"] is string clave){<div class="alert alert-warning"><strong>Credencial individual de @TempData["UsuarioEmergencia"]</strong><br><code>@clave</code><br>Se muestra una sola vez. Entregala por un canal privado. El usuario deberá cambiarla al ingresar.</div>}
<div class="backup-heading"><div><p class="text-muted">ADMINISTRACIÓN / MONITOR / TEST</p><h2>@(contingencia?"Contención y retorno operativo":"Respaldos productivos y copia de prueba")</h2><p>@(contingencia?"Controlá el acceso, la escritura y la preparación del retorno a producción.":"Conservá copias cifradas en el NAS y restauralas cuando necesites probar casos reales.")</p></div><a href="@(contingencia?"/Respaldos?seccion=contingencia":"/Respaldos")" class="btn btn-default"><i class="fa fa-refresh"></i> Actualizar vista</a></div>
@if(!contingencia){
<div class="backup-stats"><div><span>Agente productivo</span><strong>@(s.UltimoAgenteUtc>DateTimeOffset.UtcNow.AddMinutes(-5)?"Conectado":"Sin conexión reciente")</strong><small>Última conexión: @Hora(s.UltimoAgenteUtc)</small></div><div><span>Último respaldo recibido</span><strong>@Hora(s.Archivos.OrderByDescending(a=>a.FechaUtc).FirstOrDefault()?.FechaUtc)</strong><small>@s.Archivos.Count copias · @((s.Archivos.Sum(a=>a.Bytes)/1000000m).ToString("N2")) MB</small></div><div><span>Copia para pruebas</span><strong>@(s.Restaurando?"Restaurando":s.CopiaLista?"Disponible":"Pendiente de restaurar")</strong><small>Última restauración: @Hora(s.RestauradaUtc)</small></div></div>
<div class="row"><div class="col-md-7"><section class="box box-primary"><div class="box-header"><h3 class="box-title">Crear y programar respaldos</h3></div><div class="box-body">
@if(s.ErrorAgente!=null){<div class="alert alert-warning">@s.ErrorAgente</div>}
@if(s.SolicitudPendiente!=null){<p class="text-warning">Solicitud pendiente desde @Hora(s.SolicitadaUtc). El agente la atenderá en su próxima conexión.</p>}
<form asp-action="Solicitar" method="post"><button class="btn btn-primary" disabled="@(s.SolicitudPendiente!=null)"><i class="fa fa-database"></i> Crear respaldo ahora</button></form>
<hr><form asp-action="Programar" method="post"><label><input type="checkbox" name="Programado" value="true" checked="@s.Programado"> Respaldo automático diario</label><div class="row"><div class="col-sm-6"><label>Hora de Buenos Aires</label><input class="form-control" type="time" name="Hora" value="@s.Hora" required></div><div class="col-sm-6"><label>Retención (días)</label><input class="form-control" type="number" min="2" max="90" name="RetencionDias" value="@s.RetencionDias" required></div></div><p class="help-block">Recomendado: 02:00, 14 días. También se conserva la copia usada en la restauración activa. El respaldo automático no restaura la base.</p><button class="btn btn-default">Guardar programación</button></form>
<details class="backup-details"><summary>Instalación del agente en producción</summary><p>El agente envía la DB y sus PDF e imágenes por HTTPS al NAS. Debe instalarse una vez en el servidor productivo. Este panel no abre conexiones de escritura a producción.</p><form asp-action="PrepararInstalacion" method="post"><button class="btn btn-primary">Preparar instalación por SSH</button></form><p class="help-block">Código temporal para descargar el instalador desde producción. Se solicita el primer respaldo al conectar.</p><form asp-action="Agente" method="post"><button class="btn btn-default">Descargar instalación privada</button></form><p class="help-block">Contiene la credencial del receptor y la clave de cifrado. Guardala con permisos privados; no la envíes por correo ni la subas al repositorio.</p></details>
</div></section></div><div class="col-md-5"><section class="box box-warning"><div class="box-header"><h3 class="box-title">Base de datos de mi sesión</h3></div><div class="box-body"><p>Base clonada: <strong>Test-BKUP-Productiva</strong></p><p>@Model.BaseActual</p>
@if(s.ErrorRestauracion!=null){<div class="alert alert-danger">@s.ErrorRestauracion</div>}
<form asp-action="Seleccionar" method="post"><label>Elegir datos para trabajar</label><select class="form-control" name="baseDatos"><option value="test">Actual de test</option><option value="copia" disabled="@(!s.CopiaLista || s.Restaurando)">Test-BKUP-Productiva</option></select><p class="help-block">Se aplica solo a esta sesión de desarrollador durante un máximo de 8 horas. Las otras sesiones de test no cambian.</p><button class="btn btn-warning">Aplicar a mi sesión</button></form>
<div class="backup-boundary">La copia tiene sus propios archivos. Mientras se usa para pruebas, los envíos reales de correo están bloqueados.</div>
</div></section></div></div>
<section class="box box-primary"><div class="box-header"><h3 class="box-title">Copias recibidas en el NAS</h3></div><div class="box-body table-responsive"><table class="table table-striped"><thead><tr><th>Recibida</th><th>Tamaño</th><th>Integridad SHA-256</th><th>Restaurar en la copia de prueba</th></tr></thead><tbody>@foreach(var a in s.Archivos.OrderByDescending(a=>a.FechaUtc)){<tr><td>@Hora(a.FechaUtc)<br><small>@(s.CopiaOrigen==a.Id?"Usada en la copia actual":"")</small></td><td>@((a.Bytes/1000000m).ToString("N2")) MB</td><td><small class="backup-hash">@a.Sha256</small></td><td><form asp-action="Restaurar" method="post"><input type="hidden" name="id" value="@a.Id"><label><input type="checkbox" name="confirmar" value="true" required> Reemplazar únicamente la copia y sus archivos</label><button class="btn btn-warning btn-sm" disabled="@(s.Restaurando || s.ContingenciaActiva || s.RestauracionPendiente!=null)">Restaurar</button></form></td></tr>}</tbody></table>@if(s.Archivos.Count==0){<p class="text-muted">Todavía no se recibieron copias productivas. Instalá el agente y solicitá el primer respaldo.</p>}</div></section>
}else{
<div class="row"><div class="col-md-5"><section class="box box-warning"><div class="box-header"><h3 class="box-title">Escritura de las delegaciones</h3></div><div class="box-body"><p class="backup-mode">@(s.MantenimientoDelegaciones?"Mantenimiento":"Normal")</p><p>En mantenimiento, DELEGACIÓN puede consultar pero no guardar cambios. La restricción también se aplica por URL y API.</p><form asp-action="Mantenimiento" method="post"><input type="hidden" name="activar" value="@(s.MantenimientoDelegaciones ? "false" : "true")"><button class="btn @(s.MantenimientoDelegaciones?"btn-success":"btn-warning")">@(s.MantenimientoDelegaciones?"Pasar a Normal":"Pasar a Mantenimiento")</button></form></div></section></div><div class="col-md-7"><section class="box box-danger"><div class="box-header"><h3 class="box-title">Acceso de emergencia en el NAS</h3></div><div class="box-body"><p class="backup-mode">@(s.ContingenciaActiva?"Activo hasta "+Hora(s.ContingenciaHastaUtc):"Inactivo")</p><p>Requiere restaurar una copia sin cambios de pruebas y preparar credenciales individuales. Se conservan las aprobaciones y delegaciones del respaldo; las contraseñas son independientes de Cerberus.</p><form asp-action="Contingencia" method="post"><input type="hidden" name="activar" value="@(s.ContingenciaActiva ? "false" : "true")">@if(!s.ContingenciaActiva){<label><input type="checkbox" name="confirmar" value="true" required> Confirmo activar el acceso de emergencia durante 24 horas.</label>}<button class="btn btn-danger">@(s.ContingenciaActiva?"Desactivar contingencia":"Activar contingencia")</button></form><p class="help-block">Acceso: <a href="/Login/Contingencia">/Login/Contingencia</a>. Al desactivar, las sesiones de emergencia quedan invalidadas. No se permite restaurar durante la contingencia.</p></div></section></div></div>
<section class="box box-default"><div class="box-header"><h3 class="box-title">Usuarios aprobados del respaldo productivo</h3></div><div class="box-body table-responsive"><p>Última copia restaurada. Las claves individuales caducan a los 30 días y deben cambiarse en el primer ingreso.</p><table class="table"><thead><tr><th>Usuario / Nombre</th><th>Rol</th><th>Delegación (ID)</th><th>Credencial</th><th></th></tr></thead><tbody>@foreach(var user in Model.Usuarios){var a=s.Accesos.SingleOrDefault(a=>a.Usuario.Equals(user.Usuario,StringComparison.OrdinalIgnoreCase));<tr><td>@user.Usuario<br><small>@user.Nombre</small></td><td>@user.Rol</td><td>@user.DelegacionId</td><td>@(a==null?"No preparada":"Vence "+Hora(a.HastaUtc))</td><td><form asp-action="PrepararUsuario" method="post" style="display:inline"><input type="hidden" name="usuario" value="@user.Usuario"><button class="btn btn-default btn-sm">Generar / renovar clave</button></form>@if(a!=null){<form asp-action="RevocarUsuario" method="post" style="display:inline"><input type="hidden" name="usuario" value="@user.Usuario"><button class="btn btn-danger btn-sm">Revocar</button></form>}</td></tr>}</tbody></table>@if(Model.Usuarios.Count==0){<p class="text-muted">Los usuarios aparecerán al restaurar el primer respaldo productivo.</p>}</div></section>
<section class="box box-primary"><div class="box-header"><h3 class="box-title">Preparar el retorno a producción</h3></div><div class="box-body"><p>Se comparan las altas, modificaciones y eliminaciones con la línea base del respaldo. El paquete contiene los cambios y los adjuntos, cifrados. Debe conciliarse con producción antes de importarlo: no sobrescribe datos productivos ni resuelve conflictos automáticamente.</p><form asp-action="PrepararRetorno" method="post"><label><input type="checkbox" name="confirmar" value="true" required> Cerrar la escritura de toda la copia y generar el paquete de retorno.</label><p><button class="btn btn-primary" disabled="@(!s.CopiaLista || s.Restaurando)">Preparar y descargar paquete de retorno</button></p></form>@if(s.RetornoSoloLectura){<div class="alert alert-warning">La copia quedó en solo lectura para todos los roles. La conciliación e importación en producción siguen pendientes.</div><form asp-action="ReabrirCopia" method="post"><label><input type="checkbox" name="confirmar" value="true" required> Invalidar el paquete anterior y volver a permitir cambios.</label><button class="btn btn-warning">Reabrir copia</button></form>}</div></section>
}
<details class="backup-details"><summary>Actividad del módulo</summary><table class="table"><tbody>@foreach(var e in s.Eventos.TakeLast(30).Reverse()){<tr><td>@Hora(e.FechaUtc)</td><td>@e.Usuario</td><td>@e.Accion</td></tr>}</tbody></table></details>
</div>
