@{Layout=null;}
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Keryx — Contingencia</title><link rel="stylesheet" href="/adminlte/bower_components/bootstrap/dist/css/bootstrap.css"></head><body style="background:#293e50"><main style="max-width:520px;margin:7vh auto;padding:32px;background:white;border-radius:8px"><h1 class="text-center">Keryx</h1><h3 class="text-center">Acceso de contingencia</h3><p class="text-muted">Base recuperada en el NAS. Usá tu usuario y la credencial individual de emergencia entregada por el desarrollador.</p>
@if(ViewBag.Error is string error){<div class="alert alert-danger">@error</div>}
@if(ViewBag.Activa is true){<form method="post" action="/Login/Contingencia">@Html.AntiForgeryToken()<div class="form-group"><label>Usuario</label><input class="form-control" name="usuario" maxlength="100" autocomplete="username" required></div><div class="form-group"><label>Clave de emergencia</label><input class="form-control" type="password" name="password" maxlength="256" autocomplete="current-password" required></div><button class="btn btn-primary btn-block">Ingresar</button></form>}else{<div class="alert alert-warning">El desarrollador todavía no activó la contingencia.</div>}
<p style="margin-top:20px"><a href="/Login">Volver al acceso de test</a></p></main></body></html>
