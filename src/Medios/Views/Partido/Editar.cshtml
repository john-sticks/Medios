@using Medios.Entities
@model Partido

@{
    ViewData["Title"] = "Editar Partido";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var delegaciones = ViewBag.Delegaciones as List<Delegacion> ?? new();
    var superintendencias = ViewBag.Superintendencias as List<AreaResponsabilidad> ?? new();
}

<div class="row">
    <div class="col-md-6">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-map-o"></i> @Model.Nombre</h3>
            </div>
            <div class="box-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }
                <form method="post" asp-controller="Partido" asp-action="Editar">
                    <input type="hidden" name="id" value="@Model.IdPartido" />

                    <div class="form-group">
                        <label>Delegación <span class="text-red">*</span></label>
                        <select name="delegacionId" class="form-control" required>
                            @foreach (var d in delegaciones)
                            {
                                if (d.Id == Model.DelegacionId) { <option value="@d.Id" selected="selected">@d.Nombre</option> }
                                else { <option value="@d.Id">@d.Nombre</option> }
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Superintendencia <span class="text-red">*</span></label>
                        <select name="superintendenciaId" class="form-control" required>
                            @foreach (var s in superintendencias)
                            {
                                if (s.Id == Model.IdAreaResponsabilidad) { <option value="@s.Id" selected="selected">@s.AmbitoResponsabilidad</option> }
                                else { <option value="@s.Id">@s.AmbitoResponsabilidad</option> }
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Guardar</button>
                    <a href="/Partido/Listado" class="btn btn-default">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>
