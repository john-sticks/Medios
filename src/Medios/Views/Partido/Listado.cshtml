@using Medios.Entities
@model List<Partido>

@{
    ViewData["Title"] = "Partidos";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var delegaciones = ViewBag.Delegaciones as List<Delegacion> ?? new();
    var fq = ViewBag.FiltroQ as string;
    var fDeleg = ViewBag.FiltroDelegacionId as int?;
}

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success alert-dismissible"><button type="button" class="close" data-dismiss="alert">&times;</button>@TempData["Ok"]</div>
}

<div class="row">
    <div class="col-md-12">
        <div class="box box-default">
            <div class="box-body">
                <form method="get" asp-controller="Partido" asp-action="Listado" class="form-inline" style="gap:8px; flex-wrap:wrap; display:flex;">
                    <div class="form-group">
                        <label style="margin-right:4px;">Buscar</label>
                        <input type="text" name="q" class="form-control input-sm" value="@fq" placeholder="Nombre del partido" />
                    </div>
                    <div class="form-group">
                        <label style="margin-right:4px;">Delegación</label>
                        <select name="delegacionId" class="form-control input-sm">
                            <option value="">Todas</option>
                            @foreach (var d in delegaciones)
                            {
                                <option value="@d.Id" selected="@(fDeleg == d.Id)">@d.Nombre</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm"><i class="fa fa-search"></i> Filtrar</button>
                    <a href="/Partido/Listado" class="btn btn-default btn-sm">Limpiar</a>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-map-o"></i> Partidos <span class="badge bg-blue">@Model.Count</span></h3>
            </div>
            <div class="box-body no-padding">
                @if (!Model.Any())
                {
                    <p class="text-muted" style="padding:16px;">Sin resultados.</p>
                }
                else
                {
                    <table class="table table-hover table-condensed" style="margin-bottom:0;">
                        <thead>
                            <tr>
                                <th>Partido</th>
                                <th>Delegación</th>
                                <th style="width:60px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model)
                            {
                                <tr>
                                    <td><strong>@p.Nombre</strong></td>
                                    <td>@(p.Delegacion?.Nombre ?? "—")</td>
                                    <td class="text-right">
                                        <a href="@Url.Action("Editar", new { id = p.IdPartido })" class="btn btn-xs btn-default" title="Editar">
                                            <i class="fa fa-pencil"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>
