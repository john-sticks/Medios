@model Medios.Entities.Sintesis
<div class="btn-group">
    <button type="button" class="btn btn-success btn-sm dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
        <i class="fa fa-download"></i> Descargar <span class="caret"></span>
    </button>
    <ul class="dropdown-menu dropdown-menu-right">
        <li><a href="@Url.Action("DescargarPdf", "Sintesis", new { id = Model.Id })"><i class="fa fa-file-pdf-o"></i> PDF</a></li>
        @if (!User.IsInRole("DELEGACION") && !Medios.Services.ArchivoPdfService.FechaCargaUtc(Model.PDFPath).HasValue)
        {
            <li><a href="@Url.Action("DescargarWord", "Sintesis", new { id = Model.Id })"><i class="fa fa-file-word-o"></i> Word (.docx)</a></li>
        }
    </ul>
</div>
