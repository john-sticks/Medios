@using Medios.Entities
@model List<Sintesis>
@{
    ViewData["Title"] = "Síntesis Publicadas";
    var filtroTipo = ViewBag.FiltroTipo as string;
    bool busquedaRealizada = ViewBag.BusquedaRealizada;
}
<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title"><i class="fa fa-search"></i> Buscar síntesis publicadas</h3>
        <p class="help-block" style="margin-bottom:0">Consultá las síntesis consolidadas e informadas por fecha de síntesis. Período máximo: 15 días, contando ambas fechas.</p>
    </div>
    <div class="box-body">
        <form method="get" asp-action="Publicadas">
            <input type="hidden" name="buscar" value="true" />
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="row">
                <div class="col-sm-6 col-md-3 form-group">
                    <label for="desde">Desde</label>
                    <input id="desde" name="desde" type="date" value="@ViewBag.Desde" class="form-control" required />
                </div>
                <div class="col-sm-6 col-md-3 form-group">
                    <label for="hasta">Hasta</label>
                    <input id="hasta" name="hasta" type="date" value="@ViewBag.Hasta" class="form-control" required />
                </div>
                <div class="col-sm-6 col-md-3 form-group">
                    <label for="tipo">Tipo de síntesis</label>
                    <select id="tipo" name="tipo" class="form-control">
                        <option value="">Todos los tipos</option>
                        <option value="Matutina" selected="@(filtroTipo == "Matutina")">Matutina</option>
                        <option value="Vespertina" selected="@(filtroTipo == "Vespertina")">Vespertina</option>
                        <option value="Especiales" selected="@(filtroTipo == "Especiales")">Especiales y ampliaciones</option>
                    </select>
                </div>
                <div class="col-sm-6 col-md-3 form-group">
                    <label class="hidden-xs" style="display:block" aria-hidden="true">&nbsp;</label>
                    <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> Buscar</button>
                    <a asp-action="Publicadas" class="btn btn-default">Limpiar</a>
                </div>
            </div>
        </form>
    </div>
</div>
<div class="box box-default">
    <div class="box-header with-border">
        <h3 class="box-title">Resultados @if (busquedaRealizada && ViewData.ModelState.IsValid) { <span class="badge">@Model.Count</span> }</h3>
        @if (busquedaRealizada && ViewData.ModelState.IsValid)
        {
            <p class="help-block" style="margin-bottom:0">Período: @DateOnly.Parse((string)ViewBag.Desde).ToString("dd/MM/yyyy") al @DateOnly.Parse((string)ViewBag.Hasta).ToString("dd/MM/yyyy"). Ordenadas desde la fecha más reciente.</p>
        }
    </div>
    <div class="box-body">
        @if (!busquedaRealizada)
        {
            <p class="text-muted" style="margin:12px 0"><i class="fa fa-calendar"></i> Elegí un período y presioná <strong>Buscar</strong> para consultar las síntesis publicadas.</p>
        }
        else if (!ViewData.ModelState.IsValid)
        {
            <p class="text-muted">Revisá los filtros de búsqueda para consultar las publicaciones.</p>
        }
        else if (Model.Count == 0)
        {
            <p class="text-muted">No hay síntesis publicadas para el período y tipo seleccionados.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead><tr><th>Fecha de síntesis</th><th>Tipo</th><th>Notas</th><th>Informada</th><th>Acciones</th></tr></thead>
                    <tbody>
                    @foreach (var sintesis in Model)
                    {
                        var color = sintesis.Tipo switch { "Matutina" => "#f39c12", "Vespertina" => "#8B4513", _ => "#c0392b" };
                        var textoColor = sintesis.Tipo == "Matutina" ? "#111" : "#fff";
                        <tr>
                            <td style="vertical-align:middle"><strong>@sintesis.Fecha.ToString("dd/MM/yyyy")</strong></td>
                            <td style="vertical-align:middle"><span class="label" style="background:@color;color:@textoColor">@sintesis.Tipo</span> @if (sintesis.EsFiltrada) { <span class="label label-info">Filtrada</span> }</td>
                            <td style="vertical-align:middle">@sintesis.NotasIncluidas.Count</td>
                            <td style="vertical-align:middle">@(sintesis.FechaInformada?.ToString("dd/MM/yyyy HH:mm") ?? "Sin fecha registrada")</td>
                            <td style="white-space:nowrap">
                                <a asp-action="Detalle" asp-route-id="@sintesis.Id" class="btn btn-default btn-sm"><i class="fa fa-eye"></i> Ver detalle</a>
                                @if (!string.IsNullOrEmpty(sintesis.PDFPath))
                                {
                                    <a asp-action="DescargarPdf" asp-route-id="@sintesis.Id" class="btn btn-success btn-sm"><i class="fa fa-file-pdf-o"></i> PDF</a>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
@section Scripts {
    <script>
        (() => {
            const desde = document.getElementById('desde');
            const hasta = document.getElementById('hasta');
            function limitarPeriodo() {
                if (!desde.value) { hasta.removeAttribute('min'); hasta.removeAttribute('max'); return; }
                const limite = new Date(desde.value + 'T00:00:00Z');
                limite.setUTCDate(limite.getUTCDate() + 14);
                hasta.min = desde.value;
                hasta.max = limite.toISOString().slice(0, 10);
            }
            desde.addEventListener('change', limitarPeriodo);
            limitarPeriodo();
        })();
    </script>
}