@using Medios.Entities
@model List<GrupoCorreo>
@{ ViewData["Title"] = "Grupos de correo"; }
<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title"><i class="fa fa-address-book"></i> Grupos de correo</h3>
        <a asp-action="Nuevo" class="btn btn-primary pull-right"><i class="fa fa-plus"></i> Nuevo grupo</a>
    </div>
    <div class="box-body">
        @if (TempData["Ok"] != null) { <div class="alert alert-success">@TempData["Ok"]</div> }
        <p class="text-muted">Organizá destinatarios para elegirlos al informar una síntesis, junto a las delegaciones con correo configurado.</p>
        <div class="table-responsive">
            <table class="table table-striped">
                <thead><tr><th>Grupo</th><th>Contactos</th><th>Estado</th><th>Acciones</th></tr></thead>
                <tbody>
                @foreach (var grupo in Model)
                {
                    <tr>
                        <td><strong>@grupo.Nombre</strong></td><td>@grupo.Contactos.Count</td>
                        <td>@(grupo.Activo ? "Activo" : "Inactivo")</td>
                        <td>
                            <a asp-action="Editar" asp-route-id="@grupo.Id" class="btn btn-default btn-sm"><i class="fa fa-pencil"></i> Editar</a>
                            <form asp-action="Eliminar" method="post" style="display:inline" onsubmit="return confirm('¿Eliminar este grupo y sus contactos? Los envíos anteriores se conservan.');">
                                <input type="hidden" name="id" value="@grupo.Id" />
                                <button class="btn btn-danger btn-sm" type="submit"><i class="fa fa-trash"></i> Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0) { <tr><td colspan="4" class="text-muted">Todavía no hay grupos. Creá uno para comenzar a agregar contactos.</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>
