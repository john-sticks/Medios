@* Categoría es el único selector visible. El servidor deriva y valida el ámbito. *@
@using Medios.Entities
@using Medios.Services
@{
    var p = ViewData["AmbitoPrefix"] as string ?? "";
    var cats = (ViewData["Categorias"] as IEnumerable<CategoriaNoticia> ?? Enumerable.Empty<CategoriaNoticia>()).OrderBy(c => c.Orden).ToList();
    var catId = (int)(ViewData["CatIdInicial"] ?? 0);
    var ambitoInicial = ViewData["AmbitoInicial"] as string ?? "";
    // Nacional/Provincial históricos pueden tener otra categoría o ninguna.
    if (ambitoInicial is "Nacional" or "Provincial")
        catId = cats.FirstOrDefault(c => CategoriaNotaPolicy.Ambito(c.Nombre) == ambitoInicial)?.Id ?? catId;
}

<input type="hidden" name="ambitoNota" id="hAmbito@(p)" />
<div class="col-md-6">
    <div class="form-group">
        <label>Categoría <span class="text-red">*</span></label>
        <select name="categoriaId" id="selCat@(p)" class="form-control" required>
            <option value="">— Seleccioná —</option>
            @foreach (var cat in cats)
            {
                <option value="@cat.Id" data-ambito="@CategoriaNotaPolicy.Ambito(cat.Nombre)" selected="@(cat.Id == catId)">@cat.Nombre</option>
            }
        </select>
    </div>
</div>

<script>
(function () {
    function init() {
        var select = document.getElementById('selCat@(p)');
        var ambito = document.getElementById('hAmbito@(p)');
        var partido = document.getElementById('selPartido@(p)') || document.getElementById('selPartido');
        var direccion = document.getElementById('inputDireccion@(p)') || document.getElementById('inputDireccion');
        var localidad = document.getElementById('selLocalidad@(p)') || document.getElementById('selLocalidad');
        if (!select || !ambito) return;
        function sync() {
            var opcion = select.options[select.selectedIndex];
            ambito.value = opcion ? opcion.getAttribute('data-ambito') || '' : '';
            var esPartido = ambito.value === 'Partido';
            if (partido) partido.required = esPartido;
            if (direccion) direccion.required = esPartido;
            if (localidad) localidad.required = false;
        }
        select.addEventListener('change', sync);
        sync();
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
})();
</script>
