@inject Medios.Services.Respaldos.ModoOperativoStore Operativo
@{var modo=await Operativo.LeerAsync();}
<section class="box @(modo.Mantenimiento?"box-warning":"box-success")"><div class="box-body" style="display:flex;flex-wrap:wrap;gap:14px 24px;justify-content:space-between;align-items:center"><div><strong>Operación de las delegaciones: @(modo.Mantenimiento?"Mantenimiento":"Normal")</strong><p class="text-muted" style="margin:5px 0 0">En mantenimiento pueden consultar, pero sus cambios quedan bloqueados en formularios, URL y API.</p></div><form action="/Monitor/Modo" method="post" style="margin:0">@Html.AntiForgeryToken()<input type="hidden" name="activar" value="@(modo.Mantenimiento ? "false" : "true")"><button class="btn @(modo.Mantenimiento?"btn-success":"btn-warning")">@(modo.Mantenimiento?"Pasar a Normal":"Pasar a Mantenimiento")</button></form></div></section>
