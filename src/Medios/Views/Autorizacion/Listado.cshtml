@using Medios.Entities
@{
    ViewData["Title"] = "Autorizaciones de Usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var delegaciones = ViewBag.Delegaciones as List<Delegacion> ?? new List<Delegacion>();
    var ambitos = ViewBag.Ambitos as List<AreaResponsabilidad> ?? new List<AreaResponsabilidad>();
    var esDesarrollador = (bool)(ViewBag.EsDesarrollador ?? false);
    var roles = new[] { "DELEGACION", "MEDIOS" };
    if (esDesarrollador) roles = roles.Append("DESARROLLADOR").ToArray();
}

<div class="row">
    <div class="col-md-12">
        <div class="box">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-id-card-o"></i> Solicitudes de Autorización</h3>
                <div class="box-tools pull-right">
                    <button class="btn btn-xs btn-default btn-filtro active" data-estado="">Todas</button>
                    <button class="btn btn-xs btn-warning btn-filtro" data-estado="pendiente">Pendientes</button>
                    <button class="btn btn-xs btn-success btn-filtro" data-estado="aprobada">Aprobadas</button>
                    <button class="btn btn-xs btn-danger btn-filtro" data-estado="rechazada">Rechazadas</button>
                </div>
            </div>
            <div class="box-body" style="padding-bottom:0;">
                <div class="form-inline" style="display:flex; gap:8px; flex-wrap:wrap;">
                    <div class="form-group">
                        <div class="input-group input-group-sm">
                            <span class="input-group-addon"><i class="fa fa-search"></i></span>
                            <input type="text" id="inputBuscar" class="form-control" placeholder="Legajo o nombre" style="min-width:200px;" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label style="margin-right:4px;">Rol</label>
                        <select id="filtroRol" class="form-control input-sm">
                            <option value="">Todos</option>
                            @foreach (var r in roles)
                            {
                                <option value="@r">@r</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label style="margin-right:4px;">Delegación</label>
                        <select id="filtroDeleg" class="form-control input-sm">
                            <option value="">Todas</option>
                            @foreach (var d in delegaciones)
                            {
                                <option value="@d.Id">@d.Nombre</option>
                            }
                        </select>
                    </div>
                    <button type="button" class="btn btn-default btn-sm" onclick="limpiarFiltros()">
                        <i class="fa fa-eraser"></i> Limpiar
                    </button>
                </div>
            </div>
            <div class="box-body no-padding">
                <table class="table table-striped table-hover" id="tablaAutorizaciones">
                    <thead>
                        <tr>
                            <th>Legajo</th>
                            <th>Nombre</th>
                            <th>Destino</th>
                            <th>Jerarquía</th>
                            <th>Rol</th>
                            <th>Ámbito asignado</th>
                            <th>Estado</th>
                            <th>Fecha</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tbody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal aprobar -->
<div class="modal fade" id="modalAprobar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success" style="color:white;">
                <h4 class="modal-title"><i class="fa fa-check"></i> Aprobar solicitud</h4>
            </div>
            <div class="modal-body">
                <p>Ingresá el <strong>código de 6 dígitos</strong> de la solicitud impresa:</p>
                <input type="text" id="inputCodigo" class="form-control" maxlength="6"
                       placeholder="000000" style="font-size:24px;text-align:center;letter-spacing:8px;font-weight:bold;" />
                <div id="errorCodigo" class="text-danger" style="margin-top:8px;display:none;">Código incorrecto o inválido</div>

                <hr />
                <div class="form-group">
                    <label>Rol</label>
                    <select id="selRol" class="form-control">
                        @foreach (var r in roles)
                        {
                            <option value="@r">@r</option>
                        }
                    </select>
                </div>

                <p><strong>Asignar delegación:</strong> <small class="text-muted">(la superintendencia se asigna automáticamente según la delegación)</small></p>

                <div class="form-group">
                    <label>Delegación</label>
                    <select id="selDelegacion" class="form-control">
                        <option value="">— Sin delegación asignada —</option>
                        @foreach (var d in delegaciones)
                        {
                            <option value="@d.Id">@d.Nombre</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default" data-dismiss="modal">Cancelar</button>
                <button class="btn btn-success" onclick="confirmarAprobacion()">
                    <i class="fa fa-check"></i> Aprobar y asignar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal cambiar delegación -->
<div class="modal fade" id="modalCambiarDeleg" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info" style="color:white;">
                <h4 class="modal-title"><i class="fa fa-exchange"></i> Cambiar delegación</h4>
            </div>
            <div class="modal-body">
                <p class="text-muted">La superintendencia se reasigna automáticamente según la nueva delegación.</p>
                <div class="form-group">
                    <label>Delegación</label>
                    <select id="selCambiarDeleg" class="form-control">
                        @foreach (var d in delegaciones)
                        {
                            <option value="@d.Id">@d.Nombre</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default" data-dismiss="modal">Cancelar</button>
                <button class="btn btn-info" onclick="confirmarCambiarDeleg()">
                    <i class="fa fa-save"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal cambiar rol -->
<div class="modal fade" id="modalCambiarRol" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-purple" style="color:white;">
                <h4 class="modal-title"><i class="fa fa-user-circle"></i> Cambiar rol</h4>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Rol</label>
                    <select id="selCambiarRol" class="form-control">
                        @foreach (var r in roles)
                        {
                            <option value="@r">@r</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default" data-dismiss="modal">Cancelar</button>
                <button class="btn btn-purple" onclick="confirmarCambiarRol()">
                    <i class="fa fa-save"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var idActual = null;
    var estadoFiltro = '';
    var allData = [];

    $(document).ready(function () { cargarTodo(); });

    $('.btn-filtro').on('click', function () {
        $('.btn-filtro').removeClass('active');
        $(this).addClass('active');
        estadoFiltro = $(this).data('estado');
        render();
    });

    $(document).on('input', '#inputBuscar', render);
    $(document).on('change', '#filtroRol', render);
    $(document).on('change', '#filtroDeleg', render);

    function limpiarFiltros() {
        document.getElementById('inputBuscar').value = '';
        document.getElementById('filtroRol').value = '';
        document.getElementById('filtroDeleg').value = '';
        render();
    }

    // Carga todos los datos (última autorización por usuario) y renderiza con los filtros
    async function cargarTodo() {
        const res = await fetch('/api/autorizacion/listado');
        allData = await res.json();
        render();
    }

    function render() {
        const q = (document.getElementById('inputBuscar').value || '').toLowerCase().trim();
        const fRol = document.getElementById('filtroRol').value;
        const fDeleg = document.getElementById('filtroDeleg').value;

        const data = allData.filter(x => {
            if (estadoFiltro && x.estado !== estadoFiltro) return false;
            if (fRol && (x.rol || '') !== fRol) return false;
            if (fDeleg && String(x.delegacionId || '') !== fDeleg) return false;
            if (q) {
                const hay = ((x.legajo || '') + ' ' + (x.nombre || '') + ' ' + (x.usuario || '')).toLowerCase();
                if (!hay.includes(q)) return false;
            }
            return true;
        });
        renderRows(data);
    }

    function renderRows(data) {
        const tbody = document.getElementById('tbody');
        tbody.innerHTML = '';

        if (!data.length) {
            tbody.innerHTML = '<tr><td colspan="9" class="text-center text-muted">Sin resultados</td></tr>';
            return;
        }

        data.forEach(x => {
            let badge = x.estado === 'aprobada'
                ? '<span class="label label-success">Aprobada</span>'
                : x.estado === 'pendiente'
                ? '<span class="label label-warning">Pendiente</span>'
                : '<span class="label label-danger">Rechazada</span>';

            // Estado de acceso (solo aprobados)
            if (x.estado === 'aprobada') {
                badge += x.activo
                    ? ' <span class="label label-success"><i class="fa fa-check-circle"></i> Activo</span>'
                    : ' <span class="label label-default"><i class="fa fa-ban"></i> Inactivo</span>';
            }

            const fecha = new Date(x.fechaSolicitud).toLocaleString('es-AR');

            const rolBadge = x.rol ? `<span class="label" style="background:#605ca8;">${x.rol}</span>` : '<span class="text-muted">—</span>';

            const ambito = x.delegacion ? `<span class="label label-info">Deleg: ${x.delegacion.nombre}</span>`
                : x.ambito ? `<span class="label label-primary">Ámbito: ${x.ambito.ambitoResponsabilidad}</span>`
                : '<span class="text-muted">—</span>';

            let acciones;
            if (x.estado === 'pendiente') {
                acciones = `<button class="btn btn-xs btn-success" onclick="abrirAprobar(${x.id}, '${x.rol || ''}')"><i class="fa fa-check"></i> Aprobar</button>
                   <button class="btn btn-xs btn-danger" onclick="rechazar(${x.id})" style="margin-left:4px;"><i class="fa fa-ban"></i> Rechazar</button>
                   <a href="/Autorizacion/Imprimir/${x.id}" target="_blank" class="btn btn-xs btn-default" style="margin-left:4px;"><i class="fa fa-print"></i></a>`;
            } else if (x.estado === 'aprobada') {
                const delegActual = x.delegacionId || '';
                const toggleBtn = x.activo
                    ? `<button class="btn btn-xs btn-warning" onclick="toggleActivo(${x.id})" title="Desactivar acceso"><i class="fa fa-ban"></i> Desactivar</button>`
                    : `<button class="btn btn-xs btn-success" onclick="toggleActivo(${x.id})" title="Activar acceso"><i class="fa fa-check"></i> Activar</button>`;
                acciones = `${toggleBtn}
                   <button class="btn btn-xs" style="background:#605ca8;color:#fff;margin-left:4px;" onclick="abrirCambiarRol(${x.id}, '${x.rol || ''}')" title="Cambiar rol"><i class="fa fa-user-circle"></i> Rol</button>
                   <button class="btn btn-xs btn-info" onclick="abrirCambiarDeleg(${x.id}, '${delegActual}')" style="margin-left:4px;" title="Cambiar delegación"><i class="fa fa-exchange"></i> Delegación</button>
                   <a href="/Autorizacion/Imprimir/${x.id}" target="_blank" class="btn btn-xs btn-default" style="margin-left:4px;"><i class="fa fa-print"></i></a>`;
            } else {
                acciones = `<a href="/Autorizacion/Imprimir/${x.id}" target="_blank" class="btn btn-xs btn-default"><i class="fa fa-print"></i> Ver</a>`;
            }

            tbody.innerHTML += `<tr>
                <td>${x.legajo || '-'}</td>
                <td><strong>${x.nombre}</strong><br/><small class="text-muted">${x.usuario || ''}</small></td>
                <td><small>${x.destino || '-'}</small></td>
                <td>${x.jerarquia || '-'}</td>
                <td>${rolBadge}</td>
                <td>${ambito}</td>
                <td>${badge}</td>
                <td><small>${fecha}</small></td>
                <td>${acciones}</td>
            </tr>`;
        });
    }

    function abrirAprobar(id, rol) {
        idActual = id;
        document.getElementById('inputCodigo').value = '';
        document.getElementById('errorCodigo').style.display = 'none';
        document.getElementById('selDelegacion').value = '';
        if (rol) document.getElementById('selRol').value = rol;  // pre-seleccionar el rol solicitado
        $('#modalAprobar').modal('show');
        setTimeout(() => document.getElementById('inputCodigo').focus(), 500);
    }

    async function confirmarAprobacion() {
        const codigo = document.getElementById('inputCodigo').value.trim();
        const delegacionId = document.getElementById('selDelegacion').value || null;
        const rol = document.getElementById('selRol').value;

        if (codigo.length !== 6) {
            document.getElementById('errorCodigo').textContent = 'El código debe tener 6 dígitos';
            document.getElementById('errorCodigo').style.display = 'block';
            return;
        }

        const res = await fetch('/api/autorizacion/aprobar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                id: idActual,
                codigo: codigo,
                rol: rol,
                delegacionId: delegacionId ? parseInt(delegacionId) : null,
                ambitoId: null
            })
        });

        if (res.ok) {
            $('#modalAprobar').modal('hide');
            toastr.success('Solicitud aprobada y ámbito asignado');
            cargarTodo();
        } else {
            document.getElementById('errorCodigo').textContent = 'Código incorrecto o solicitud inválida';
            document.getElementById('errorCodigo').style.display = 'block';
        }
    }

    async function rechazar(id) {
        if (!confirm('¿Rechazar esta solicitud?')) return;
        const res = await fetch('/api/autorizacion/rechazar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(id)
        });
        if (res.ok) { toastr.warning('Solicitud rechazada'); cargarTodo(); }
    }

    // ── Activar / Desactivar acceso ──────────────────────────────
    async function toggleActivo(id) {
        const res = await fetch('/api/autorizacion/toggle-activo', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(id)
        });
        if (res.ok) {
            const data = await res.json();
            toastr.success(data.activo ? 'Acceso activado' : 'Acceso desactivado');
            cargarTodo();
        } else {
            toastr.error('No se pudo cambiar el estado');
        }
    }

    // ── Cambiar delegación ───────────────────────────────────────
    var idCambiarDeleg = null;
    function abrirCambiarDeleg(id, delegActual) {
        idCambiarDeleg = id;
        if (delegActual) document.getElementById('selCambiarDeleg').value = delegActual;
        $('#modalCambiarDeleg').modal('show');
    }

    async function confirmarCambiarDeleg() {
        const delegacionId = document.getElementById('selCambiarDeleg').value;
        if (!delegacionId) { toastr.warning('Seleccioná una delegación'); return; }
        const res = await fetch('/api/autorizacion/cambiar-delegacion', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: idCambiarDeleg, delegacionId: parseInt(delegacionId) })
        });
        if (res.ok) {
            $('#modalCambiarDeleg').modal('hide');
            toastr.success('Delegación actualizada');
            cargarTodo();
        } else {
            toastr.error('No se pudo cambiar la delegación');
        }
    }

    // ── Cambiar rol ──────────────────────────────────────────────
    var idCambiarRol = null;
    function abrirCambiarRol(id, rolActual) {
        idCambiarRol = id;
        if (rolActual) document.getElementById('selCambiarRol').value = rolActual;
        $('#modalCambiarRol').modal('show');
    }

    async function confirmarCambiarRol() {
        const rol = document.getElementById('selCambiarRol').value;
        const res = await fetch('/api/autorizacion/cambiar-rol', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: idCambiarRol, rol: rol })
        });
        if (res.ok) {
            $('#modalCambiarRol').modal('hide');
            toastr.success('Rol actualizado');
            cargarTodo();
        } else {
            toastr.error('No se pudo cambiar el rol');
        }
    }
</script>
}
