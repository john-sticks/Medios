@{
    ViewData["Title"] = "Solicitud de Autorización";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var usuario   = User.FindFirst("Usuario")?.Value ?? "";
    var nombre    = User.FindFirst("NombreSolo")?.Value ?? "";
    var apellido  = User.FindFirst("Apellido")?.Value ?? "";
    var email     = User.FindFirst("Email")?.Value ?? "";
    var destino   = User.FindFirst("Dependencia")?.Value ?? "";
    var jerarquia = User.FindFirst("Jerarquia")?.Value ?? "";
    var legajo    = User.FindFirst("Legajo")?.Value ?? "";
    var telefono  = User.FindFirst("Telefono")?.Value ?? "";
}

<div class="row">
    <div class="col-md-8 col-md-offset-2">
        <div class="box box-warning">
            <div class="box-header with-border text-center" style="padding:20px 15px;">
                <h2 style="margin:0;color:#8a6d3b;">
                    <i class="fa fa-id-card-o"></i> Autorización de Uso — División Medios
                </h2>
                <p style="margin:5px 0 0;color:#666;">Sistema de Gestión y Análisis de Información Criminal</p>
            </div>
            <div class="box-body">
                <div class="callout callout-warning">
                    <p>Para poder acceder al sistema debés generar tu solicitud de autorización.
                    Una vez generada, Medios la aprobará, te asignará el ámbito
                    correspondiente y podrás ingresar.</p>
                </div>

                <table class="table table-bordered" style="margin-top:15px;">
                    <tbody>
                        <tr><th style="width:35%">Usuario</th><td><strong>@usuario</strong></td></tr>
                        <tr><th>Nombre</th><td>@nombre @apellido</td></tr>
                        <tr><th>Correo electrónico</th><td>@email</td></tr>
                        <tr><th>Destino actual</th><td>@destino</td></tr>
                        <tr><th>Jerarquía</th><td>@jerarquia</td></tr>
                        <tr><th>Legajo</th><td>@legajo</td></tr>
                        <tr><th>Teléfono</th><td>@telefono</td></tr>
                    </tbody>
                </table>

                <div class="text-center" style="margin-top:20px;">
                    <form method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-warning btn-lg">
                            <i class="fa fa-paper-plane"></i> Generar Solicitud de Autorización
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
