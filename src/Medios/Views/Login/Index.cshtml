@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Acceso — División Medios</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css">
    <style>
        body { background: #2c3e50; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; }
        .login-box { background: #fff; border-radius: 6px; padding: 40px; width: 360px; box-shadow: 0 4px 20px rgba(0,0,0,0.3); }
        .login-box h3 { margin-top: 0; color: #2c3e50; text-align: center; }
        .login-box .subtitle { text-align: center; color: #7f8c8d; font-size: 13px; margin-bottom: 24px; }
        .btn-ingresar { background: #2980b9; color: #fff; width: 100%; padding: 10px; border: none; border-radius: 4px; font-size: 15px; cursor: pointer; }
        .btn-ingresar:hover { background: #1f6391; }
        .header-logo { text-align: center; margin-bottom: 20px; }
        .header-logo img { max-width: 120px; }
    </style>
</head>
<body>
    <div class="login-box">
        <h3>División Medios</h3>
        <p class="subtitle">Sistema de Gestión y Análisis de Información Criminal</p>

        <form method="post" asp-controller="Login" asp-action="Index">
            <div class="form-group">
                <label>Usuario</label>
                <input name="Usuario" class="form-control" placeholder="Usuario" maxlength="50" required autofocus />
            </div>
            <div class="form-group">
                <label>Contraseña</label>
                <input name="Password" type="password" class="form-control" placeholder="Contraseña" maxlength="50" required />
            </div>

            @if (!string.IsNullOrEmpty(ViewBag.Error))
            {
                <div class="alert alert-danger" style="padding: 8px 12px; margin-bottom: 12px;">
                    @ViewBag.Error
                </div>
            }

            <button type="submit" class="btn-ingresar">Ingresar</button>
        </form>
    </div>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.12.4/jquery.min.js"></script>
</body>
</html>
