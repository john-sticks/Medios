@inject Medios.Services.Respaldos.RespaldoStore RespaldosLogin
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Keryx</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css">
    <style>
        body { background: #2c3e50; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; }
        .login-box { background: #fff; border-radius: 6px; padding: 40px; width: 360px; box-shadow: 0 4px 20px rgba(0,0,0,0.3); }
        .login-box h3 { margin-top: 0; color: #2c3e50; text-align: center; }
        .login-box .form-group { margin-bottom: 20px; }
        .password-field { position: relative; }
        .password-field .form-control { padding-right: 42px; }
        .password-toggle { position: absolute; top: 0; right: 0; width: 38px; height: 100%; border: 0; border-radius: 0 4px 4px 0; background: transparent; color: #475569; cursor: pointer; }
        .password-toggle:focus-visible { outline: 2px solid #2980b9; outline-offset: -3px; }
        .login-box .subtitle { text-align: center; color: #7f8c8d; font-size: 13px; margin-bottom: 0; }
        .restricted-access-wrap { text-align: center; }
        .login-access-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 2px 10px;
            margin-top: 12px;
            margin-bottom: 16px;
            border-radius: 9999px;
            background-color: #f1f5f9;
            color: #475569;
            font-size: 12px;
            line-height: 16px;
            font-weight: 500;
        }
        .restricted-access-dot { width: 6px; height: 6px; flex-shrink: 0; border-radius: 50%; background: #22c55e; }
        .btn-ingresar { background: #2980b9; color: #fff; width: 100%; padding: 10px; border: none; border-radius: 4px; font-size: 15px; cursor: pointer; }
        .btn-ingresar:hover { background: #1f6391; }
        .header-logo { text-align: center; margin-bottom: 20px; }
        .header-logo img { max-width: 120px; }
    </style>
</head>
<body>
    <div class="login-box">
        <h3>Keryx</h3>
        <p class="subtitle">Sistema de Prensa</p>
        <div class="restricted-access-wrap">
            <span class="login-access-badge"><span class="restricted-access-dot" aria-hidden="true"></span>Acceso restringido</span>
        </div>

        <form method="post" asp-controller="Login" asp-action="Index">
            <div class="form-group">
                <input name="Usuario" aria-label="Usuario" class="form-control" placeholder="Usuario" maxlength="50" required autofocus />
            </div>
            <div class="form-group password-field">
                <input id="loginPassword" name="Password" aria-label="Contraseña" type="password" class="form-control" placeholder="Contraseña" maxlength="50" autocomplete="current-password" required />
                <button id="togglePassword" type="button" class="password-toggle" aria-controls="loginPassword" aria-label="Mostrar contraseña" aria-pressed="false" title="Mostrar contraseña">
                    <span id="passwordToggleIcon" class="glyphicon glyphicon-eye-open" aria-hidden="true"></span>
                </button>
            </div>

            @if (!string.IsNullOrEmpty(ViewBag.Error))
            {
                <div class="alert alert-danger" style="padding: 8px 12px; margin-bottom: 12px;">
                    @ViewBag.Error
                </div>
            }

            <button type="submit" class="btn-ingresar">Ingresar</button>
        </form>
@if(RespaldosLogin.Habilitado && (await RespaldosLogin.LeerAsync()).ContingenciaActiva){<p style="text-align:center;margin:18px 0 0"><a href="/Login/Contingencia">Ingresar con credencial de contingencia</a></p>}
    </div>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.12.4/jquery.min.js"></script>
    <script>
        document.getElementById('togglePassword').addEventListener('click', function () {
            const campo = document.getElementById('loginPassword');
            const mostrar = campo.type === 'password';
            campo.type = mostrar ? 'text' : 'password';
            const etiqueta = mostrar ? 'Ocultar contraseña' : 'Mostrar contraseña';
            this.setAttribute('aria-label', etiqueta);
            this.setAttribute('aria-pressed', String(mostrar));
            this.title = etiqueta;
            document.getElementById('passwordToggleIcon').className = 'glyphicon glyphicon-eye-' + (mostrar ? 'close' : 'open');
        });
    </script>
</body>
</html>
