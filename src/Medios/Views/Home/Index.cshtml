@using Medios.Services
@using System.Security.Claims
@inject Medios.Security.MenuXmlService menuService
@model DashboardMetricas

@{
    ViewData["Title"] = "Inicio";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var esMedios     = User.IsInRole("MEDIOS");
    var esDelegacion = User.IsInRole("DELEGACION") && !esMedios;
    var rolMostrar   = User.FindFirst(ClaimTypes.Role)?.Value ?? "";

    var autPendientes = (int)(ViewBag.AutorizacionesPendientes ?? 0);
}

<style>
    /* AdminLTE trunca .info-box-text a una línea con ellipsis — con las etiquetas más
       largas de este panel queda ilegible ("SESIONES PAR…", "AUTORIZACIONES PENDIEN…").
       Achicamos la letra y permitimos que ajuste en 2 líneas en vez de cortar el texto. */
    .info-box-text {
        font-size: 12px;
        white-space: normal;
        line-height: 1.25;
    }
</style>

<!-- Saludo -->
<div class="row">
    <div class="col-md-12">
        <p style="font-size:15px; color:#555; margin-bottom:14px;">
            <i class="fa fa-user-circle"></i>
            Bienvenido, <strong>@User.Identity?.Name</strong>
            <span class="label" style="background:#3c8dbc;">@rolMostrar</span>
        </p>
    </div>
</div>

@* ════════════════ MEDIOS — revisión, consolidación y panel administrativo ════════════════ *@
@if (esMedios)
{
    @if (autPendientes > 0)
    {
        <div class="row">
            <div class="col-md-12">
                <a href="/Autorizacion/Listado" style="text-decoration:none; color:inherit;">
                    <div class="info-box bg-red" style="cursor:pointer;">
                        <span class="info-box-icon"><i class="fa fa-id-card"></i></span>
                        <div class="info-box-content">
                            <span class="info-box-text">Autorizaciones pendientes de Usuarios</span>
                            <span class="info-box-number">@autPendientes</span>
                            <span class="progress-description">Solicitudes de acceso/revalidación esperando aprobación — clic para revisarlas.</span>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    }
    <div class="row">
        <div class="col-md-4 col-sm-6">
            <a href="/Autorizacion/Listado" style="color:inherit; text-decoration:none;">
                <div class="info-box bg-aqua"><span class="info-box-icon"><i class="fa fa-id-card-o"></i></span>
                    <div class="info-box-content"><span class="info-box-text">Autorizaciones pendientes de Usuarios</span>
                        <span class="info-box-number">@autPendientes</span></div></div>
            </a>
        </div>
        <div class="col-md-4 col-sm-6">
            <a href="/Sintesis/Consolidar" style="color:inherit; text-decoration:none;">
                <div class="info-box bg-navy"><span class="info-box-icon"><i class="fa fa-flag-checkered"></i></span>
                    <div class="info-box-content"><span class="info-box-text">Finalizadas para consolidar</span>
                        <span class="info-box-number">@(ViewBag.SesionesFinalizadas ?? 0)</span></div></div>
            </a>
        </div>
        <div class="col-md-4 col-sm-6">
            <a href="/Sesion/Bandeja#consolidadas" style="color:inherit; text-decoration:none;">
                <div class="info-box" style="background:#605ca8; color:#fff;"><span class="info-box-icon"><i class="fa fa-object-group"></i></span>
                    <div class="info-box-content"><span class="info-box-text">Consolidadas sin informar</span>
                        <span class="info-box-number">@(ViewBag.ConsolidadasPendientes ?? 0)</span></div></div>
            </a>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="box box-primary">
                <div class="box-header with-border"><h3 class="box-title">Acciones rápidas</h3></div>
                <div class="box-body">
                    <a href="/Sesion/Bandeja#remitidas" class="btn btn-warning btn-block" style="margin-bottom:8px;">
                        <i class="fa fa-search"></i> Síntesis Pendientes (estado remitidas y procesando)
                        <span class="badge" style="background:rgba(255,255,255,0.3);">@Model.SesionesRevisadas</span></a>
                    <a href="/Nota/Nueva" class="btn btn-info btn-block">
                        <i class="fa fa-plus"></i> Agregar nota (División Medios)</a>
                </div>
            </div>
        </div>
    </div>
}

@* ════════════════ DELEGACION ════════════════ *@
@if (esDelegacion)
{
    var descartadas = (int)(ViewBag.NotasDescartadas ?? 0);
    @if (descartadas > 0)
    {
        <div class="row">
            <div class="col-md-12">
                <a href="/Sesion/Mias" style="text-decoration:none; color:inherit;">
                    <div class="info-box bg-red" style="cursor:pointer;">
                        <span class="info-box-icon"><i class="fa fa-exclamation-triangle"></i></span>
                        <div class="info-box-content">
                            <span class="info-box-text">Notas descartadas por Medios</span>
                            <span class="info-box-number">@descartadas</span>
                            <span class="progress-description">Volvieron para corregir y reenviar — clic para verlas.</span>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    }
    <div class="row">
        <div class="col-md-4 col-sm-6">
            <a href="/Sesion/Mias" style="color:inherit; text-decoration:none;">
                <div class="info-box bg-yellow"><span class="info-box-icon"><i class="fa fa-pencil-square-o"></i></span>
                    <div class="info-box-content"><span class="info-box-text">Mis borradores</span>
                        <span class="info-box-number">@(ViewBag.MisBorradores ?? 0)</span></div></div>
            </a>
        </div>
        <div class="col-md-4 col-sm-6">
            <a href="/Sintesis/Listado" style="color:inherit; text-decoration:none;">
                <div class="info-box bg-green"><span class="info-box-icon"><i class="fa fa-check"></i></span>
                    <div class="info-box-content"><span class="info-box-text">Síntesis aprobadas</span>
                        <span class="info-box-number">@(ViewBag.SintesisAprobadas ?? 0)</span></div></div>
            </a>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="info-box bg-red"><span class="info-box-icon"><i class="fa fa-reply"></i></span>
                <div class="info-box-content"><span class="info-box-text">Notas descartadas</span>
                    <span class="info-box-number">@descartadas</span></div></div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="box box-primary">
                <div class="box-header with-border"><h3 class="box-title">Acciones rápidas</h3></div>
                <div class="box-body">
                    <a href="/Sesion/Nueva" class="btn btn-success btn-block" style="margin-bottom:8px;">
                        <i class="fa fa-plus"></i> Nueva Sesión de Prensa</a>
                    <a href="/Sesion/Mias" class="btn btn-default btn-block">
                        <i class="fa fa-list"></i> Ver mis sesiones</a>
                </div>
            </div>
        </div>
    </div>
}
