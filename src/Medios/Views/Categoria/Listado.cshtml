@using Medios.Entities
@model List<CategoriaNoticia>

@{
    ViewData["Title"] = "Categorías";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        @TempData["Ok"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        @TempData["Error"]
    </div>
}

<div class="row">
    <div class="col-md-8">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-tags"></i> Categorías de Notas</h3>
                <div class="box-tools pull-right">
                    <a href="@Url.Action("Editar")" class="btn btn-success btn-sm">
                        <i class="fa fa-plus"></i> Nueva Categoría
                    </a>
                </div>
            </div>
            <div class="box-body no-padding">
                @if (!Model.Any())
                {
                    <p class="text-muted" style="padding:16px;">No hay categorías cargadas.</p>
                }
                else
                {
                    <table class="table table-hover table-condensed" style="margin-bottom:0;">
                        <thead>
                            <tr>
                                <th style="width:60px;">Orden</th>
                                <th>Nombre</th>
                                <th style="width:90px;">Estado</th>
                                <th style="width:100px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cat in Model)
                            {
                                <tr style="@(cat.Activa ? "" : "opacity:0.55;")">
                                    <td><span class="badge bg-gray">@cat.Orden</span></td>
                                    <td><strong>@cat.Nombre</strong></td>
                                    <td>
                                        @if (cat.Activa)
                                        { <span class="label label-success">Activa</span> }
                                        else
                                        { <span class="label label-default">Inactiva</span> }
                                    </td>
                                    <td class="text-right">
                                        <a href="@Url.Action("Editar", new { id = cat.Id })" class="btn btn-xs btn-default" title="Editar">
                                            <i class="fa fa-pencil"></i>
                                        </a>
                                        <form method="post" asp-controller="Categoria" asp-action="Eliminar" style="display:inline; margin-left:2px;">
                                            <input type="hidden" name="id" value="@cat.Id" />
                                            <button type="submit" class="btn btn-xs btn-danger" title="Eliminar"
                                                    onclick="return confirm('¿Eliminar la categoría «@cat.Nombre»?')">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>
