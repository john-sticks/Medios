@using Medios.Entities
@model CategoriaNoticia

@{
    var esNueva = Model.Id == 0;
    ViewData["Title"] = esNueva ? "Nueva Categoría" : "Editar Categoría";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-5">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h3 class="box-title">
                    <i class="fa fa-tags"></i> @ViewData["Title"]
                </h3>
            </div>
            <div class="box-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }
                <form method="post" asp-controller="Categoria" asp-action="Editar">
                    <input type="hidden" name="id" value="@(esNueva ? "" : Model.Id.ToString())" />

                    <div class="form-group">
                        <label>Nombre <span class="text-red">*</span></label>
                        <input type="text" name="nombre" class="form-control"
                               value="@Model.Nombre" required maxlength="100" autofocus />
                    </div>
                    <div class="form-group">
                        <label>Orden <span class="text-red">*</span></label>
                        <input type="number" name="orden" class="form-control"
                               value="@Model.Orden" required min="1" max="999"
                               style="width:100px;" />
                        <span class="help-block">Determina el orden en los listados y el PDF de síntesis.</span>
                    </div>
                    <div class="form-group">
                        <label>
                            <input type="checkbox" name="activa" value="true"
                                   @(Model.Activa ? "checked" : "") />
                            Activa
                        </label>
                        <span class="help-block">Solo las categorías activas aparecen al crear notas.</span>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-save"></i> @(esNueva ? "Crear" : "Guardar")
                    </button>
                    <a href="@Url.Action("Listado")" class="btn btn-default">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>
